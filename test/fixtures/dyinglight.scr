!Resolution(i,i)
!WindowOffset(i,i)
!Monitor(i)                    // -1 primary monitor
!TextureQuality(s)             // Low, Medium, High
!GammaFloat(f)
!Shadows(s)                    // Low, High
!ShadowMapSize(i)
!SpotShadowMapSize(i)
!Fullscreen()
!Borderless()
!MaxFPS(i)						// Max frame rate
!VSync(i)                      // vertical sync; 0 - disable, 1 - every frame, 2 - every 2 frames, etc.
!VSyncDisableBelowTarget(i)    // 1 - enable; 0 - disable
!GrassQuality(i)               // lower is better
!NvidiaEffects(i,i,i)          // enable extra nvidia effects(hbao+,dof,pcss)
!ExtraGameFov(f)               // extra fov
!VisRange(f,f)
!TinyObjectsRange(f)
!OculusEnabled()               // enable support for Oculus
!AmbientOcclusion(i)           // 1 - enable; 0 - disable
!MotionBlur(i)                 // 1 - enable; 0 - disable
!AntiAliasing(i)               // 1 - enable; 0 - disable
!DisableDWM(i)                 // disables DWM when fullscreen
!3dtvSettings(f,f)           // /3dtv ui depth, scene separation/offset (-0.15, 0.041, -0.00722)
!Version(i)

Resolution(1920,1080)
Fullscreen()
MaxFPS(144)
Monitor(0)
TextureQuality("High")
VisRange(2.10, 2.10)
TinyObjectsRange(1.50)
ShadowMapSize(4096)
SpotShadowMapSize(4096)
GammaFloat(1.00)
GrassQuality(0)
VSync(0)
NvidiaEffects(1, 1, 1)
AmbientOcclusion(1)
MotionBlur(0)
AntiAliasing(1)
DisableDWM(1)
3dtvSettings(-0.150000, 0.000000)
Version(1)
