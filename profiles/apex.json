    },
    {
      "name": "PCGamesN",
      "url": "https://www.pcgamesn.com/apex-legends/apex-legends-nvidia-amd-pc-performance-benchmark"
    },
    {
      "name": "Digital Trends",
      "url": "https://www.digitaltrends.com/?p=3375999"
    }
  ],
  "settings": [
