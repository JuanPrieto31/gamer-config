{
  "id": "dyinglight",
  "version": 4,
  "name": "Dying Light",
  "games": [
    "steam-239140"
  ],
  "config": {
    "path": "{docs}/DyingLight/out/settings/video.scr",
    "format": "scr"
  },
  "processes": [
    "DyingLightGame.exe"
  ],
  "note": "La distancia de visión es lo que más importa con diferencia: bajarla casi duplica los FPS mínimos y carga sobre todo la CPU (PCGamingWiki). El desenfoque de profundidad de NVIDIA cuesta mucho, y las sombras en Alto rinden casi igual que en Máximo (r/OptimizedGaming).",
  "sources": [
    {
      "name": "PCGamingWiki",
      "url": "https://community.pcgamingwiki.com/blog/features/port-reports/pc-report-dying-light-r176/"
    },
    {
      "name": "r/OptimizedGaming",
      "url": "https://www.reddit.com/r/OptimizedGaming/comments/105a882/dying_light_optimized_settings/"
    },
    {
      "name": "NVIDIA",
      "url": "https://www.nvidia.com/en-us/geforce/news/dying-light-graphics-and-performance-guide/"
    }
  ],
  "settings": [
    {
      "key": "VisRange",
      "label": "Distancia de visión",
      "visual": 2,
      "why": "Lo que más FPS cuesta con diferencia, y sobre todo al procesador: bajarla casi duplica los FPS mínimos (PCGamingWiki).",
      "levels": [
        [
          "0.50, 0.50",
          "Mínima",
          0,
          {
            "cpu": 0
          }
        ],
        [
          "0.80, 0.80",
          "Baja",
          3,
          {
            "cpu": 10
          }
        ],
        [
          "1.20, 1.20",
          "Media",
          6,
          {
            "cpu": 22
          }
        ],
        [
          "1.60, 1.60",
          "Alta",
          10,
          {
            "cpu": 36
          }
        ],
        [
          "2.10, 2.10",
          "Máxima",
          15,
          {
            "cpu": 55
          }
        ]
      ]
    },
    {
      "key": "NvidiaEffects",
      "label": "Efectos NVIDIA (HBAO+, desenfoque, PCSS)",
      "visual": 1,
      "why": "El desenfoque de profundidad cuesta mucho en partida; HBAO+ y PCSS son mejoras visuales caras (r/OptimizedGaming, NVIDIA).",
      "levels": [
        [
          "0, 0, 0",
          "Todos desactivados",
          0
        ],
        [
          "1, 0, 0",
          "Solo HBAO+",
          8
