        ],
        [
          "2",
          "Medio",
          2,
          {
            "cpu": 2
          }
        ],
        [
          "3",
          "Alto",
          3,
          {
            "cpu": 3
          }
        ],
        [
          "4",
          "Muy alto",
          4,
          {
            "cpu": 4
          }
        ]
      ]
    },
    {
      "key": "Performance.EnableFXAA",
      "label": "Antialiasing (FXAA)",
      "visual": 1,
      "why": "Suaviza bordes con un coste mínimo, pero emborrona un poco la imagen.",
      "levels": [
        [
          "0",
          "Desactivado",
          0
        ],
        [
          "1",
          "Activado",
          2
        ]
      ]
    },
    {
      "key": "General.HideEyeCandy",
      "label": "Decoración del mapa",
      "visual": 0.5,
      "why": "Elementos decorativos que no aportan al juego.",
      "levels": [
        [
          "1",
          "Oculta",
          0
        ],
        [
          "0",
          "Visible",
          1
        ]
      ]
    },
    {
      "key": "General.WaitForVerticalSync",
      "label": "Sincronización vertical",
      "why": "Añade retraso al ratón. Mejor desactivada en un juego competitivo.",
