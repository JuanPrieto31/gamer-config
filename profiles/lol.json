        [
          "0",
          "Desactivada"
        ],
        [
          "1",
          "Activada"
        ]
      ],
      "fixed": {
        "fps": "0",
        "equilibrado": "0",
        "calidad": "0"
      }
    }
  ],
  "demandCpu": "Intel Core i5-3300 / AMD Ryzen 3 1200",
  "demandRamGb": 8
}
