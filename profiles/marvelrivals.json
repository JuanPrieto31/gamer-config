{
  "id": "marvelrivals",
  "version": 3,
  "name": "Marvel Rivals",
  "games": ["steam-2767030"],
  "names": ["Marvel Rivals"],
  "config": { "path": "{localappdata}/Marvel/Saved/Config/Windows/GameUserSettings.ini", "format": "flat" },
  "processes": ["Marvel-Win64-Shipping.exe", "Marvel.exe"],
  "note": "Unreal Engine 5 con Lumen: la iluminación global es de lejos lo más caro. Bajarla a Media o Baja es lo que más FPS da.",
  "sources": [
    { "name": "Epic Games (escalabilidad de Unreal)", "url": "https://dev.epicgames.com/documentation/en-us/unreal-engine/scalability-reference-for-unreal-engine" },
    { "name": "NVIDIA (ajustes óptimos: el escalado va activado en todos los pasos)", "url": "https://www.nvidia.com/en-us/geforce/technologies/dlss/" }
  ],
  "settings": [
    { "key": "SuperSamplingQuality", "label": "Escalado (DLSS)", "tech": "dlss", "upscaler": true, "visual": 1,
      "why": "Dibuja a menos resolución y la reconstruye con IA: es lo que más FPS da por calidad perdida.",
      "levels": [["4", "DLSS Rendimiento", 0, { "also": { "AntiAliasingSuperSamplingMode": "4" }, "mode": "rendimiento" }],
                 ["3", "DLSS Equilibrado", 10, { "also": { "AntiAliasingSuperSamplingMode": "4" }, "visual": 4, "mode": "equilibrado" }],
                 ["2", "DLSS Calidad", 21, { "also": { "AntiAliasingSuperSamplingMode": "4" }, "visual": 3, "mode": "calidad" }],
                 ["0", "DLAA (resolución nativa)", 70, { "also": { "AntiAliasingSuperSamplingMode": "4" }, "visual": 1, "mode": "nativo" }]] },
    { "key": "SuperSamplingQuality", "label": "Escalado (FSR)", "tech": "fsr", "upscaler": true, "visual": 2,
      "why": "Dibuja a menos resolución y la reescala: muchos más FPS, algo menos nítido. Funciona en cualquier gráfica.",
      "levels": [["4", "FSR Rendimiento", 0, { "also": { "AntiAliasingSuperSamplingMode": "6" }, "mode": "rendimiento" }],
                 ["3", "FSR Equilibrado", 10, { "also": { "AntiAliasingSuperSamplingMode": "6" }, "visual": 5, "mode": "equilibrado" }],
                 ["2", "FSR Calidad", 21, { "also": { "AntiAliasingSuperSamplingMode": "6" }, "visual": 4, "mode": "calidad" }],
                 ["0", "Desactivado (resolución nativa)", 70, { "also": { "AntiAliasingSuperSamplingMode": "0" }, "visual": 2, "mode": "nativo", "off": true }]] },
    { "key": "SuperSamplingQuality", "label": "Escalado (XeSS)", "tech": "xess", "upscaler": true, "visual": 2,
      "why": "El escalado de Intel: en Intel Arc usa sus núcleos de IA; en el resto de gráficas funciona en modo compatible.",
      "levels": [["5", "XeSS Rendimiento", 0, { "also": { "AntiAliasingSuperSamplingMode": "7" }, "mode": "rendimiento" }],
                 ["4", "XeSS Equilibrado", 10, { "also": { "AntiAliasingSuperSamplingMode": "7" }, "visual": 5, "mode": "equilibrado" }],
                 ["3", "XeSS Calidad", 21, { "also": { "AntiAliasingSuperSamplingMode": "7" }, "visual": 4, "mode": "calidad" }],
                 ["0", "XeSS nativo (resolución nativa)", 70, { "also": { "AntiAliasingSuperSamplingMode": "7" }, "visual": 2, "mode": "nativo" }]] },
    { "key": "bDlssFrameGeneration", "label": "Generación de fotogramas (DLSS)", "tech": "dlss-fg", "framegen": true,
      "why": "Inventa fotogramas entre los reales: más FPS en pantalla, con algo más de retraso. RTX 40 (2x) y RTX 50 (hasta 4x).",
      "levels": [["False", "Desactivada", 0, { "mode": "off" }],
                 ["True", "2x", 0, { "also": { "DlssFrameGenerationCount": "1" }, "mode": "2x" }],
                 ["True", "3x", 0, { "also": { "DlssFrameGenerationCount": "2" }, "mode": "3x" }],
                 ["True", "4x", 0, { "also": { "DlssFrameGenerationCount": "3" }, "mode": "4x" }]] },
    { "key": "bFSRFrameGeneration", "label": "Generación de fotogramas (FSR)", "tech": "fsr-fg", "framegen": true,
      "why": "FSR 3: inventa un fotograma entre cada dos reales en cualquier gráfica, con algo más de retraso.",
      "levels": [["False", "Desactivada", 0, { "mode": "off" }], ["True", "2x", 0, { "mode": "2x" }]] },
    { "key": "bNvidiaReflex", "label": "NVIDIA Reflex", "requires": "nvidia", "latency": true, "why": "Menos retraso entre el ratón y la pantalla, sin perder FPS.",
      "levels": [["False", "Desactivado", 0, { "mode": "off" }], ["True", "Activado", 0, { "mode": "on" }]],
      "fixed": { "fps": "True", "equilibrado": "True", "calidad": "True" } },
    { "key": "sg.GlobalIlluminationQuality", "label": "Iluminación global", "visual": 2, "why": "Lumen: lo que más FPS cuesta en este juego.",
      "levels": [["0", "Baja", 0], ["1", "Media", 12], ["2", "Alta", 25], ["3", "Ultra", 40]] },
    { "key": "sg.ShadowQuality", "label": "Sombras", "visual": 2,
      "levels": [["0", "Bajas", 0], ["1", "Medias", 8, { "cpu": 2 }], ["2", "Altas", 16, { "cpu": 4 }], ["3", "Ultra", 26, { "cpu": 6 }]] },
    { "key": "sg.ReflectionQuality", "label": "Reflejos", "visual": 1,
      "levels": [["0", "Bajos", 0], ["1", "Medios", 5], ["2", "Altos", 10], ["3", "Ultra", 16]] },
    { "key": "sg.EffectsQuality", "label": "Efectos", "visual": 1, "why": "Habilidades de los héroes: se notan en peleas de 12 jugadores.",
      "levels": [["0", "Bajos", 0], ["1", "Medios", 4], ["2", "Altos", 8], ["3", "Ultra", 12]] },
    { "key": "sg.PostProcessQuality", "label": "Postprocesado", "visual": 1,
      "levels": [["0", "Bajo", 0], ["1", "Medio", 3], ["2", "Alto", 6], ["3", "Ultra", 9]] },
    { "key": "sg.ViewDistanceQuality", "label": "Distancia de visión", "visual": 1,
      "levels": [["0", "Cerca", 0, { "cpu": 0 }], ["1", "Media", 3, { "cpu": 4 }], ["2", "Lejos", 6, { "cpu": 8 }], ["3", "Ultra", 9, { "cpu": 12 }]] },
    { "key": "sg.FoliageQuality", "label": "Vegetación", "visual": 1,
      "levels": [["0", "Baja", 0], ["1", "Media", 2], ["2", "Alta", 4], ["3", "Ultra", 6]] },
    { "key": "sg.AntiAliasingQuality", "label": "Antialiasing", "visual": 1,
      "levels": [["0", "Bajo", 0], ["1", "Medio", 2], ["2", "Alto", 4], ["3", "Ultra", 6]] },
    { "key": "sg.TextureQuality", "label": "Texturas", "why": "No cuesta FPS mientras quepa en la memoria de la gráfica.",
      "levels": [["0", "Bajas", 0, { "vram": 2 }], ["1", "Medias", 0, { "vram": 3 }], ["2", "Altas", 0, { "vram": 5 }], ["3", "Ultra", 0, { "vram": 7 }]] }
  ]
}
